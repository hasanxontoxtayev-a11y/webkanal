{
  "manifest_version": 3,
  "name": "TubePilot AI — YouTube HUD & Copilot",
  "version": "1.0.0",
  "description": "Universal VidIQ-grade YouTube HUD, real-time views velocity (VPH), localized RPM earnings calculator, SEO diagnostic, and YouTube Studio AI companion.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "https://www.tubepilotpro.com/*",
    "https://tubepilotpro.com/*",
    "http://localhost:3001/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TubePilot AI Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtube.com/*",
        "http://*.youtube.com/*",
        "http://youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
